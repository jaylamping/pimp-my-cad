{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "pimp-my-cad",
  "version": "0.1.0",
  "identifier": "app.pimpmycad.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "pimp-my-cad", "width": 1400, "height": 900, "dragDropEnabled": true }],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": "all"
  }
}
