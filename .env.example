# cp .env.example .env, then fill these in.
POSTGRES_PASSWORD=change-me
S3_SECRET_KEY=change-me-too-at-least-8-chars
# openssl rand -base64 32   (wraps each workspace's data key; losing it makes comments unreadable)
PIMP_MASTER_KEY=
# openssl rand -hex 24      (bootstrap admin token; the web app and tools use it)
PIMP_ADMIN_TOKEN=

# Folder with your STEP/3MF/STL exports, mounted read-only and imported by hash.
# On Windows use forward slashes. Keep the Docker data volumes on the WSL2/Linux side.
CAD_DIR=J:/code/marengo/hardware
